msgid "Rules"
msgstr "Reglas"

msgid "General"
msgstr "General"

msgid "Configure Magic Folder…"
msgstr "Configurar Magic Folder…"

msgid "Drop files onto the panel icon to move them automatically."
msgstr "Soltá archivos sobre el ícono del panel para moverlos automáticamente."

msgid "Active rules: %1 of %2"
msgstr "Reglas activas: %1 de %2"

msgid "Configure rules…"
msgstr "Configurar reglas…"

msgid "Add rule"
msgstr "Agregar regla"

msgid "No rules defined"
msgstr "No hay reglas definidas"

msgid "Click \"Add rule\" to get started"
msgstr "Hacé clic en \"Agregar regla\" para comenzar"

msgid "Set a destination folder first"
msgstr "Configurá una carpeta destino primero"

msgid "Disable rule"
msgstr "Desactivar regla"

msgid "Enable rule"
msgstr "Activar regla"

msgid "⚠ No destination folder — click edit"
msgstr "⚠ Sin carpeta destino — hacé clic en editar"

msgid "Edit"
msgstr "Editar"

msgid "Move up"
msgstr "Subir"

msgid "Move down"
msgstr "Bajar"

msgid "Delete"
msgstr "Eliminar"

msgid "Edit rule"
msgstr "Editar regla"

msgid "Name:"
msgstr "Nombre:"

msgid "E.g.: Videos"
msgstr "Ej.: Vídeos"

msgid "Extensions:"
msgstr "Extensiones:"

msgid "mp4, mkv, avi"
msgstr "mp4, mkv, avi"

msgid "Destination folder:"
msgstr "Carpeta destino:"

msgid "/home/user/Videos"
msgstr "/home/usuario/Vídeos"

msgid "Browse…"
msgstr "Explorar…"

msgid "Icon (optional):"
msgstr "Ícono (opcional):"

msgid "video-x-generic"
msgstr "video-x-generic"

msgid "Suggested icons: video-x-generic · audio-x-generic · image-x-generic · x-office-document · application-zip · text-x-script · application-x-executable · application-epub+zip"
msgstr "Íconos sugeridos: video-x-generic · audio-x-generic · image-x-generic · x-office-document · application-zip · text-x-script · application-x-executable · application-epub+zip"

msgid "Notifications:"
msgstr "Notificaciones:"

msgid "Show notification after each operation"
msgstr "Mostrar notificación luego de cada operación"

msgid "If the file already exists:"
msgstr "Si el archivo ya existe:"

msgid "Skip (don't move)"
msgstr "Omitir (no mover)"

msgid "Keep both (rename: file_1.ext)"
msgstr "Mantener ambos (renombrar: archivo_1.ext)"

msgid "Overwrite"
msgstr "Sobreescribir"

msgid "⚠  Files are moved permanently. Verify your rules and destination folders before using them with important files."
msgstr "⚠  Los archivos se mueven de forma permanente. Verificá las reglas y carpetas destino antes de usarlas con archivos importantes."

msgid "Restore default rules"
msgstr "Restaurar reglas predeterminadas"

msgid "Restore default rules?"
msgstr "¿Restaurar reglas predeterminadas?"

msgid "This will delete all custom rules and restore the 9 default categories (disabled, no destination set). Continue?"
msgstr "Esto eliminará todas las reglas personalizadas y restaurará las 9 categorías predefinidas (desactivadas, sin destino). ¿Continuar?"
