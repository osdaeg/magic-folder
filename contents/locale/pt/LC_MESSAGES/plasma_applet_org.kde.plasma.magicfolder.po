msgid "Rules"
msgstr "Regras"

msgid "General"
msgstr "Geral"

msgid "Configure Magic Folder…"
msgstr "Configurar Magic Folder…"

msgid "Drop files onto the panel icon to move them automatically."
msgstr "Solte arquivos no ícone do painel para movê-los automaticamente."

msgid "Active rules: %1 of %2"
msgstr "Regras ativas: %1 de %2"

msgid "Configure rules…"
msgstr "Configurar regras…"

msgid "Add rule"
msgstr "Adicionar regra"

msgid "No rules defined"
msgstr "Nenhuma regra definida"

msgid "Click \"Add rule\" to get started"
msgstr "Clique em \"Adicionar regra\" para começar"

msgid "Set a destination folder first"
msgstr "Configure uma pasta de destino primeiro"

msgid "Disable rule"
msgstr "Desativar regra"

msgid "Enable rule"
msgstr "Ativar regra"

msgid "⚠ No destination folder — click edit"
msgstr "⚠ Sem pasta de destino — clique em editar"

msgid "Edit"
msgstr "Editar"

msgid "Move up"
msgstr "Mover para cima"

msgid "Move down"
msgstr "Mover para baixo"

msgid "Delete"
msgstr "Excluir"

msgid "Edit rule"
msgstr "Editar regra"

msgid "Name:"
msgstr "Nome:"

msgid "E.g.: Videos"
msgstr "Ex.: Vídeos"

msgid "Extensions:"
msgstr "Extensões:"

msgid "mp4, mkv, avi"
msgstr "mp4, mkv, avi"

msgid "Destination folder:"
msgstr "Pasta de destino:"

msgid "/home/user/Videos"
msgstr "/home/usuario/Videos"

msgid "Browse…"
msgstr "Procurar…"

msgid "Icon (optional):"
msgstr "Ícone (opcional):"

msgid "video-x-generic"
msgstr "video-x-generic"

msgid "Suggested icons: video-x-generic · audio-x-generic · image-x-generic · x-office-document · application-zip · text-x-script · application-x-executable · application-epub+zip"
msgstr "Ícones sugeridos: video-x-generic · audio-x-generic · image-x-generic · x-office-document · application-zip · text-x-script · application-x-executable · application-epub+zip"

msgid "Notifications:"
msgstr "Notificações:"

msgid "Show notification after each operation"
msgstr "Mostrar notificação após cada operação"

msgid "If the file already exists:"
msgstr "Se o arquivo já existir:"

msgid "Skip (don't move)"
msgstr "Ignorar (não mover)"

msgid "Keep both (rename: file_1.ext)"
msgstr "Manter ambos (renomear: arquivo_1.ext)"

msgid "Overwrite"
msgstr "Sobrescrever"

msgid "⚠  Files are moved permanently. Verify your rules and destination folders before using them with important files."
msgstr "⚠  Os arquivos são movidos permanentemente. Verifique suas regras e pastas de destino antes de usá-las com arquivos importantes."

msgid "Restore default rules"
msgstr "Restaurar regras padrão"

msgid "Restore default rules?"
msgstr "Restaurar regras padrão?"

msgid "This will delete all custom rules and restore the 9 default categories (disabled, no destination set). Continue?"
msgstr "Isso excluirá todas as regras personalizadas e restaurará as 9 categorias padrão (desativadas, sem destino). Continuar?"
